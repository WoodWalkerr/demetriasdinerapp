# Postgres connection string. Added automatically when you connect a Neon
# database to the project from the Vercel Marketplace (Storage tab).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Password your staff type on /staff to open the order board.
STAFF_PASSWORD=change-me-to-something-long

# Long random string used to sign staff login cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-64-random-hex-characters

# Your café's time zone (opening hours, happy hour, reports).
CAFE_TIMEZONE=Asia/Manila
# Optional: hour the business day starts (default 4 = 4 AM). Sales between midnight
# and 4 AM count for the night before, because you're open until 2 AM.
DAY_START_HOUR=4

# ---- Nightly summary email (optional) ----
# Free account at resend.com → API Keys → Create. Starts with re_. Leave empty to skip emails.
RESEND_API_KEY=
# Optional sender. Without your own domain, leave empty: Resend's test sender can only
# email the address you signed up to Resend with.
SUMMARY_FROM=
# Any long random string. Vercel sends it to /api/cron so only Vercel can trigger the email.
CRON_SECRET=

# ---- PayMongo (GCash, Maya, cards) ----
# Dashboard → Developers → API keys → Secret key (starts with sk_test_ while testing,
# sk_live_ for real money). Paste it after the = sign. Leave empty to offer pay-at-counter only.
PAYMONGO_SECRET_KEY=
# Dashboard → Developers → Webhooks → your webhook's signing secret (starts with whsk_).
PAYMONGO_WEBHOOK_SECRET=
# Optional: your public site address, used for PayMongo's return links.
# Leave empty to use the address the customer is on.
SITE_URL=
